PORT=3000
NODE_ENV=development

# FCM (Firebase Cloud Messaging) - API v1
# Téléchargez le fichier service-account.json depuis Firebase Console
# et indiquez son chemin ici, OU collez son contenu JSON dans FCM_SERVICE_ACCOUNT_JSON.
FCM_PROJECT_ID=msconsult-demo
FCM_SERVICE_ACCOUNT_PATH=/chemin/vers/service-account.json
# Alternative : contenu JSON sur une seule ligne
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Web Push (VAPID)
VAPID_PUBLIC_KEY=BM...
VAPID_PRIVATE_KEY=BM...
VAPID_SUBJECT=mailto:contact@msconsult.fr
